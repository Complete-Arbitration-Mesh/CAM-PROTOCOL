#!/usr/bin/env bash
# deploy_cam.sh — Full production‑grade CAM Helm deployment
# Features: RBAC, NetworkPolicy, PodSecurity, PDB, HPA, Backup CronJob, key rotation, retries

set -euo pipefail
shopt -s inherit_errexit

# -------------------- Defaults --------------------
NAMESPACE="cam"
RELEASE="cam"
CHART_VERSION=""
IMAGE_TAG="latest"
DB_SIZE="10Gi"
FASTPATH_MAX=100
MIN_CONF=0.01
MAX_RES_MS=1000
WAIT_SECS=300
RETRY_MAX=3
RETRY_DELAY=5
RES_CPU="100m"
RES_MEM="200Mi"
NETWORK_POLICY_CIDRS=""

# -------------------- Usage --------------------
usage() {
  grep '^#' "$0" | sed 's/^#//' ; exit 1
}

# -------------------- Parse Arguments --------------------
while [[ $# -gt 0 ]]; do
  case $1 in
    --namespace)      NAMESPACE=$2; shift 2;;
    --release)        RELEASE=$2; shift 2;;
    --chart-version)  CHART_VERSION=$2; shift 2;;
    --image)          IMAGE_TAG=$2; shift 2;;
    --lease-key-file) LEASE_KEY_FILE=$2; shift 2;;
    --hmac-key-file)  HMAC_KEY_FILE=$2; shift 2;;
    --tls-cert-file)  TLS_CERT_FILE=$2; shift 2;;
    --tls-key-file)   TLS_KEY_FILE=$2; shift 2;;
    --db-size)        DB_SIZE=$2; shift 2;;
    --fastpath-max)   FASTPATH_MAX=$2; shift 2;;
    --min-confidence) MIN_CONF=$2; shift 2;;
    --max-resource-ms)MAX_RES_MS=$2; shift 2;;
    --resources-cpu)  RES_CPU=$2; shift 2;;
    --resources-mem)  RES_MEM=$2; shift 2;;
    --network-policy) NETWORK_POLICY_CIDRS=$2; shift 2;;
    -h|--help)        usage;;
    *) echo "Unknown: $1"; usage;;
  esac
done

# -------------------- Validate Inputs --------------------
: "${LEASE_KEY_FILE:?--lease-key-file is required}"
: "${HMAC_KEY_FILE:?--hmac-key-file is required}"
: "${TLS_CERT_FILE:?--tls-cert-file is required}"
: "${TLS_KEY_FILE:?--tls-key-file is required}"
for cmd in helm kubectl; do
  command -v $cmd >/dev/null || { echo "$cmd required"; exit 1; }
done

# -------------------- Namespace --------------------
kubectl get ns "$NAMESPACE" >/dev/null 2>&1 || \
  kubectl create ns "$NAMESPACE"

# -------------------- RBAC --------------------
# ServiceAccount
kubectl -n "$NAMESPACE" apply -f - <<EOF
apiVersion: v1
kind: ServiceAccount
metadata:
  name: cam-sa
  namespace: "$NAMESPACE"
  labels:
    app.kubernetes.io/name: cam-starter
EOF

# Role
kubectl -n "$NAMESPACE" apply -f - <<EOF
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: cam-role
  namespace: "$NAMESPACE"
  labels:
    app.kubernetes.io/name: cam-starter
rules:
- apiGroups: [""]
  resources: ["pods","pods/log","services","configmaps","persistentvolumeclaims","secrets"]
  verbs: ["get","list","watch","create","update","patch","delete"]
- apiGroups: ["policy"]
  resources: ["poddisruptionbudgets"]
  verbs: ["get","list","watch","create","update","patch"]
EOF

# RoleBinding
kubectl -n "$NAMESPACE" apply -f - <<EOF
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: cam-rolebinding
  namespace: "$NAMESPACE"
  labels:
    app.kubernetes.io/name: cam-starter
subjects:
- kind: ServiceAccount
  name: cam-sa
  namespace: "$NAMESPACE"
roleRef:
  kind: Role
  name: cam-role
  apiGroup: rbac.authorization.k8s.io
EOF

# -------------------- Network Policy --------------------
if [[ -n "$NETWORK_POLICY_CIDRS" ]]; then
  IFS=',' read -ra CIDRS <<< "$NETWORK_POLICY_CIDRS"
  kubectl -n "$NAMESPACE" apply -f - <<EOF
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: cam-network-policy
  namespace: "$NAMESPACE"
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: cam-starter
  policyTypes: [Ingress, Egress]
  ingress:
  - from:
$(for cidr in "${CIDRS[@]}"; do echo "    - ipBlock: { cidr: \"$cidr\" }"; done)
    ports:
    - port: 50051
      protocol: TCP
  egress:
  - to:
      - podSelector:
          matchLabels:
            app: etcd
        namespaceSelector:
          matchLabels:
            name: etcd
    ports:
    - port: 2379
      protocol: TCP
EOF
fi

# -------------------- Secrets --------------------
# TLS
kubectl -n "$NAMESPACE" apply -f - <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: cam-tls-cert
  namespace: "$NAMESPACE"
  annotations:
    cam.example.com/rotation: "$(date -Iseconds)"
type: kubernetes.io/tls
data:
  tls.crt: $(base64 -w0 < "$TLS_CERT_FILE")
  tls.key: $(base64 -w0 < "$TLS_KEY_FILE")
EOF

# Lease key
kubectl -n "$NAMESPACE" apply -f - <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: cam-lease-key
  namespace: "$NAMESPACE"
  annotations:
    cam.example.com/rotation: "$(date -Iseconds)"
type: Opaque
stringData:
  key: |
$(sed 's/^/    /' "$LEASE_KEY_FILE")
EOF

# HMAC key
kubectl -n "$NAMESPACE" apply -f - <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: cam-hmac-key
  namespace: "$NAMESPACE"
  annotations:
    cam.example.com/rotation: "$(date -Iseconds)"
type: Opaque
stringData:
  key: |
$(sed 's/^/    /' "$HMAC_KEY_FILE")
EOF

# -------------------- Backup PVC --------------------
kubectl -n "$NAMESPACE" apply -f - <<EOF
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${RELEASE}-cam-backup-pvc
  namespace: "$NAMESPACE"
  labels:
    app.kubernetes.io/name: cam-starter
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: $DB_SIZE
EOF

# -------------------- Build values.yaml --------------------
VALUES=$(mktemp)
cat > "$VALUES" <<EOF
replicaCount: 2
serviceAccount:
  create: false
  name: cam-sa
image:
  repository: ghcr.io/cam-mesh/camd
  tag: "$IMAGE_TAG"
  pullPolicy: IfNotPresent
tls:
  enabled: true
  secretName: cam-tls-cert
lease:
  enabled: true
  secretName: cam-lease-key
  maxLeasesPerSec: $FASTPATH_MAX
hmac:
  secretName: cam-hmac-key
storage:
  persistence:
    size: $DB_SIZE
fastPath:
  enabled: true
minConfidence: $MIN_CONF
maxResourceMs: $MAX_RES_MS
resources:
  requests:
    cpu: $RES_CPU
    memory: $RES_MEM
  limits:
    cpu: $(awk 'BEGIN{printf("%.0f
", '"${RES_CPU%m}"'*1.5)}')m
    memory: $(awk 'BEGIN{printf("%.0f
", '"${RES_MEM%Mi}"'*1.5)}')Mi
podSecurityContext:
  runAsNonRoot: true
  runAsUser: 1000
securityContext:
  readOnlyRootFilesystem: true
  capabilities:
    drop: [ALL]
serviceMonitor:
  enabled: true
  interval: 15s
  tlsConfig:
    insecureSkipVerify: true
EOF

# -------------------- Helm Deploy with Retry --------------------
helm repo add cam https://Cognitive-Arbitration-Mesh-CAM.github.io/cam-starter/charts >/dev/null
helm repo update >/dev/null
attempt=1
until [[ $attempt -gt $RETRY_MAX ]]; do
  chart_ref="cam/cam-starter"
  [[ -n "$CHART_VERSION" ]] && chart_ref+=" --version $CHART_VERSION"
  if helm upgrade --install "$RELEASE" $chart_ref \
       -n "$NAMESPACE" -f "$VALUES" \
       --wait --timeout ${WAIT_SECS}s; then
    break
  else
    echo "⚠️ Attempt $attempt failed, retrying in $RETRY_DELAY s..."
    sleep $RETRY_DELAY
    ((attempt++))
  fi
done
rm -f "$VALUES"

# -------------------- Post‑Deploy Resources --------------------
# PodDisruptionBudget
kubectl -n "$NAMESPACE" apply -f - <<EOF
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: cam-pdb
  namespace: "$NAMESPACE"
  labels:
    app.kubernetes.io/name: cam-starter
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: cam-starter
EOF

# HorizontalPodAutoscaler
kubectl -n "$NAMESPACE" apply -f - <<EOF
apiVersion: autoscaling/v2beta2
kind: HorizontalPodAutoscaler
metadata:
  name: cam-hpa
  namespace: "$NAMESPACE"
  labels:
    app.kubernetes.io/name: cam-starter
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: $RELEASE-cam-starter
  minReplicas: 2
  maxReplicas: 10
  metrics:
  - type: Pods
    pods:
      metric:
        name: cam_queue_depth
      target:
        type: AverageValue
        averageValue: "50"
EOF

# CronJob for DB backup
kubectl -n "$NAMESPACE" apply -f - <<EOF
apiVersion: batch/v1
kind: CronJob
metadata:
  name: cam-db-backup
  namespace: "$NAMESPACE"
  labels:
    app.kubernetes.io/name: cam-starter
spec:
  schedule: "0 * * * *"
  jobTemplate:
    spec:
      template:
        spec:
          serviceAccountName: cam-sa
          restartPolicy: OnFailure
          containers:
          - name: backup
            image: alpine:3.15
            command: ["/bin/sh","-c"]
            args:
            - |
              set -e
              cp /data/cam.db /backups/cam.db-$(date +"%Y%m%d%H%M").db
            volumeMounts:
            - name: data
              mountPath: /data
            - name: backups
              mountPath: /backups
          volumes:
          - name: data
            persistentVolumeClaim:
              claimName: ${RELEASE}-cam-starter-pvc
          - name: backups
            persistentVolumeClaim:
              claimName: ${RELEASE}-cam-backup-pvc
EOF

# -------------------- Done --------------------
echo "✅ CAM deployed (release: $RELEASE, namespace: $NAMESPACE)"
