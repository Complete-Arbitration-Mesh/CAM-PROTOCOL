#!/usr/bin/env python3
import argparse
import sys
from src.client.client import Client

def main():
    parser = argparse.ArgumentParser(prog="camctl")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_enq = sub.add_parser("enqueue")
    p_enq.add_argument("job")
    p_enq.add_argument("--priority", type=int, default=0)

    p_deq = sub.add_parser("dequeue")

    p_rep = sub.add_parser("reprioritise")
    p_rep.add_argument("job_id")
    p_rep.add_argument("new_priority", type=int)

    args = parser.parse_args()
    cli = Client()

    if args.cmd == "enqueue":
        cli.enqueue(args.job, args.priority)
        print(f"Enqueued: {args.job} (priority={args.priority})")
    elif args.cmd == "dequeue":
        job = cli.dequeue()
        print(f"Dequeued: {job}")
    elif args.cmd == "reprioritise":
        cli.reprioritise(args.job_id, args.new_priority)
        print(f"Reprioritised: {args.job_id} -> {args.new_priority}")

if __name__ == "__main__":
    main()
#!/usr/bin/env bash
# ----------------------------------
# Simple license‑key manager
# ----------------------------------

COMMAND=$1; shift

case "$COMMAND" in
  gen-key)
    # usage: camctl gen-key <user-id> <basic|small|enterprise>
    python3 - <<'PYCODE'
import sys
from src.core.licensing import issue_key
if len(sys.argv)!=3:
    print("Usage: camctl gen-key <user-id> <tier>", file=sys.stderr)
    sys.exit(1)
user, tier = sys.argv[1], sys.argv[2]
print(issue_key(user, tier))
PYCODE
    ;;

  list-keys)
    python3 - <<'PYCODE'
from src.core.licensing import _KEYS
for k,t in _KEYS.items():
    print(f"{k}\t{t}")
PYCODE
    ;;

  *)
    echo "Usage: camctl {gen-key|list-keys}"
    ;;
esac
# -----------------------------------------------------------------------------
# License‑key management commands
# -----------------------------------------------------------------------------
