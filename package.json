{
  "name": "@cam-protocol/complete-arbitration-mesh",
  "version": "2.1.1",
  "description": "Intelligent orchestration and collaboration for modern AI ecosystems",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "author": "Andrew \"Dru\" Edwards <EdwardsTechPros@Outlook.com>",
  "homepage": "https://github.com/Complete-Arbitration-Mesh/CAM-PROTOCOL",
  "repository": {
    "type": "git",
    "url": "https://github.com/Complete-Arbitration-Mesh/CAM-PROTOCOL.git"
  },
  "bugs": {
    "url": "https://github.com/Complete-Arbitration-Mesh/CAM-PROTOCOL/issues"
  },
  "keywords": [
    "ai",
    "arbitration",
    "routing",
    "collaboration",
    "agents",
    "machine-learning",
    "orchestration",
    "iacp"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "tsc",
    "build:full": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:mcp": "vitest run tests/mcp",
    "test:mcp:e2e": "vitest run tests/mcp/mcp-gateway-e2e.test.ts",
    "test:mcp:demo": "tsx examples/mcp-gateway/e2e-test.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run",
    "generate:badges": "vitest run --coverage && node scripts/generate-coverage-badges.js",
    "test:performance": "ts-node scripts/run-benchmarks.ts",
    "benchmark:cost": "ts-node tests/benchmarks/cost-optimization-benchmark.ts",
    "benchmark:collaboration": "ts-node tests/benchmarks/multi-agent-collaboration-benchmark.ts",
    "demo:value": "ts-node examples/demonstration/value-demonstration.ts",
    "demo:mcp-gateway": "tsx examples/mcp-gateway/demo.ts",
    "mcp:gateway": "tsx examples/mcp-gateway/gateway-server.ts",
    "run:benchmarks": "ts-node scripts/run-benchmarks.ts",
    "validate:editions": "tsx scripts/validate-editions.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write src/**/*.{ts,tsx,json,md}",
    "clean": "rimraf dist",
    "docker:build": "docker build -t cam-protocol/complete-arbitration-mesh .",
    "docker:run": "docker run -p 8080:8080 cam-protocol/complete-arbitration-mesh",
    "deploy:staging": "npm run build && npm run deploy:staging:only",
    "deploy:production": "npm run build && npm run deploy:production:only"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.1.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0",
    "openai": "^4.75.1",
    "ora": "^5.4.1",
    "pino": "^8.21.0",
    "pino-pretty": "^11.2.2",
    "stripe": "^18.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.12.0",
    "@types/node-fetch": "^2.6.11",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^4.0.16",
    "chart.js": "^4.4.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.5",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.0.16"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-CORE",
    "LICENSE-ENTERPRISE"
  ],
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
